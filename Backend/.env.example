# Copy this file to .env and replace every CHANGE_ME value.
NODE_ENV=development
PORT=8000
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/himtrip?schema=public"
JWT_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
FRONTEND_URL="http://localhost:5173"
# Admin is created by prisma/seed.js. Use a strong temporary password and change it after first login.
ADMIN_NAME="Himtrip Admin"
ADMIN_EMAIL="mkankit2613@gmail.com"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD"
# Optional email delivery. Without these, records still save; API response indicates email is not configured.
RESEND_API_KEY=""
EMAIL_FROM="Himtrip <onboarding@resend.dev>"
SUPPORT_EMAIL="mkankit2613@gmail.com"
# Optional comma-separated extra frontend origins, e.g. https://himtrip.vercel.app
ADDITIONAL_FRONTEND_URLS=""
